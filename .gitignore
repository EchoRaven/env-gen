# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Generation artifacts / runs
generated/
runs_archive/
logs/
*.log

# Generation-engine run artifacts (written under agent/ at runtime)
agent/**/generated/
agent/**/.agent_logs/
agent/tmp/
agent/**/.worktrees/
.worktrees/

# OS / editor
.DS_Store
.idea/
.vscode/

# dev DB
*.db
forgingground_gen.db

# Dev test suites — kept local only, not part of the shipped pipeline repo.
# (Runtime assets that merely have "test" in the path are NOT matched here:
#  multi_agent/bundled_tests/ and runtime/test_user_validation.py stay tracked.)
/tests/
/agent/tests/
/agent/env_generator/llm_generator/multi_agent/tests/

# Dev run/launch scripts — kept local only, not pipeline code.
run_*.sh
launch_*.sh
check_*.sh
.env

# Design-Prep validation fixtures (local-only, like run scripts)
design_inputs/

# #829: ticket reservations are per-working-tree in-flight state, not repo history. Running the
# allocator (including from its own tests) appends here, so tracking it would churn the repo and
# permanently burn numbers on every suite run. The durable record of a claim stays where it was:
# an EXPERIMENTS heading, a commit subject, or a test filename.
.tickets

# repo-wide test-suite lock (2026-09-05, cross-session contention)
.suite.lock
.suite.lock.info
