      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="v_t" value="Page 3 · Verify &amp; Fix Loop  (max 3–5 iterations)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=15;fontColor=#ffffff;align=center;verticalAlign=middle;fillColor=#16a34a;strokeColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="800" height="46" as="geometry"/></mxCell>

        <mxCell id="v_in" value="Development output  (from Page 2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#14532d;align=center;verticalAlign=middle;fillColor=#bbf7d0;strokeColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="220" height="44" as="geometry"/></mxCell>

        <mxCell id="v_verifier" value="🤖  Verifier Agent&#10;•  Docker build  db / backend / frontend&#10;•  smoke + API + browser (Playwright) tests&#10;•  contract tests  →  recorded in RunHub" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#14532d;align=left;verticalAlign=top;spacing=10;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="380" height="120" as="geometry"/></mxCell>

        <mxCell id="v_pass" value="All&#10;pass?" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="170" y="370" width="170" height="100" as="geometry"/></mxCell>

        <mxCell id="v_triage" value="🤖  Bug Triage&#10;root-cause analysis + dispatch fixes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#14532d;align=left;verticalAlign=top;spacing=10;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="210" height="64" as="geometry"/></mxCell>

        <mxCell id="v_route" value="Failure routing — back to the owning agent:&#10;&#10;•  API failure       →  Backend Agent&#10;•  UI failure         →  Frontend Agent&#10;•  Schema failure  →  Database Agent&#10;•  Architectural    →  Orchestrator" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#7f1d1d;align=left;verticalAlign=top;spacing=10;fillColor=#fee2e2;strokeColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="340" y="500" width="380" height="124" as="geometry"/></mxCell>

        <mxCell id="v_def" value="Schema-alignment defense (3 layers):&#10;&#10;L1  write-time   — register_consumer subset check&#10;L2  merge gate   — CodeHub contract tests&#10;L3  step-time    — hub_pulse surfaces breaking changes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#78350f;align=left;verticalAlign=top;spacing=10;fillColor=#fffbeb;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="360" height="120" as="geometry"/></mxCell>

        <mxCell id="v_out" value="▸  continue to Page 4 · Deliver" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#713f12;align=center;verticalAlign=middle;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="450" y="390" width="220" height="50" as="geometry"/></mxCell>

        <mxCell id="ve1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="v_in" target="v_verifier"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ve2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="v_verifier" target="v_pass"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ve3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=11;fontStyle=1;" edge="1" parent="1" source="v_pass" target="v_triage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ve4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#dc2626;strokeWidth=1.5;" edge="1" parent="1" source="v_triage" target="v_route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ve5" value="re-test after fix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#dc2626;strokeWidth=1.5;dashed=1;fontColor=#dc2626;fontSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="v_route" target="v_verifier"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ve6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=11;fontStyle=1;" edge="1" parent="1" source="v_pass" target="v_out"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================= -->
  <!-- PAGE 5 : DELIVERY                                             -->
  <!-- ============================================================= -->
  <diagram id="deliver" name="4 · Delivery">
    <mxGraphModel dx="1100" dy="850" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="800" math="0" shadow="0" background="#f8fafc">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="d_t" value="Page 4 · Delivery" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=15;fontColor=#ffffff;align=center;verticalAlign=middle;fillColor=#ca8a04;strokeColor=#a16207;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="800" height="46" as="geometry"/></mxCell>

        <mxCell id="d_final" value="🎛  Orchestrator — finalize&#10;•  contract extraction:  spec vs generated comparison&#10;•  assemble artifacts + OpenEnv adapter&#10;•  generate README / STRUCTURE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#713f12;align=left;verticalAlign=top;spacing=10;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="370" height="110" as="geometry"/></mxCell>

        <mxCell id="d_gate" value="Deliverability report + evaluate user-defined delivery gates&#10;POST /api/projects/&lt;id&gt;/deliver&#10;User clicks Deliver  (may force with a reason if blocked)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#713f12;align=left;verticalAlign=top;spacing=10;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="370" height="90" as="geometry"/></mxCell>

        <mxCell id="d_done" value="✅  status = completed&#10;→  global SSE  →  Monitor shows “View App” preview URL / code browser / download" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#14532d;align=left;verticalAlign=top;spacing=10;fillColor=#bbf7d0;strokeColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="370" height="80" as="geometry"/></mxCell>

        <mxCell id="d_art" value="📦  Delivered artifacts — generated/&lt;name&gt;/&#10;&#10;design/             design specs (api / database / ui)&#10;app/backend     Express.js&#10;app/frontend    React + Vite&#10;app/database   PostgreSQL DDL + seed&#10;env/                 OpenEnv adapter (models / client / server)&#10;docker/            docker-compose.yml&#10;tasks/              BrowserGym task definitions (for RL training)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#713f12;align=left;verticalAlign=top;spacing=10;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="490" y="120" width="370" height="240" as="geometry"/></mxCell>

        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="d_final" target="d_gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="d_gate" target="d_done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="d_final" target="d_art"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================= -->
  <!-- PAGE 6 : HUBS & MONITOR                                       -->
  <!-- ============================================================= -->
  <diagram id="hubs" name="5 · Hubs &amp; Monitor">
    <mxGraphModel dx="1100" dy="850" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="780" math="0" shadow="0" background="#f8fafc">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="h_t" value="Page 5 · The 6 Collaboration Hubs (shared state) &amp; Live Monitoring" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=15;fontColor=#ffffff;align=center;verticalAlign=middle;fillColor=#d97706;strokeColor=#b45309;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="900" height="46" as="geometry"/></mxCell>

        <mxCell id="h_agents" value="🤖  ALL AGENTS&#10;&#10;Orchestrator / Design / Database&#10;Backend / Frontend / Verifier&#10;Knowledge&#10;+ dynamic workers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#14532d;align=center;verticalAlign=middle;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="50" y="280" width="200" height="170" as="geometry"/></mxCell>

        <mxCell id="h_pool" value="🗂  Collaboration Hubs — shared persistent state  (shared/hubs/*.json)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#78350f;verticalAlign=top;align=center;spacing=8;fillColor=#fffbeb;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="390" height="568" as="geometry"/></mxCell>
        <mxCell id="h_code" value="CodeHub — branches, commits, PRs, reviews, releases, checks  (git worktrees)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#78350f;align=left;verticalAlign=middle;spacing=8;fillColor=#fde68a;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="350" y="142" width="350" height="68" as="geometry"/></mxCell>
        <mxCell id="h_api" value="APIHub — endpoints, tables, consumers, contract tests, schema versions / breaking changes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#78350f;align=left;verticalAlign=middle;spacing=8;fillColor=#fde68a;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="350" y="222" width="350" height="68" as="geometry"/></mxCell>
        <mxCell id="h_work" value="WorkHub — pages, plans, tasks, dependencies, decisions, comments" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#78350f;align=left;verticalAlign=middle;spacing=8;fillColor=#fde68a;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="350" y="302" width="350" height="60" as="geometry"/></mxCell>
        <mxCell id="h_event" value="EventHub — agent status, events, inboxes, subscriptions, MessageBus bridge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#78350f;align=left;verticalAlign=middle;spacing=8;fillColor=#fde68a;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="350" y="374" width="350" height="68" as="geometry"/></mxCell>
        <mxCell id="h_run" value="RunHub — execution / test runs, results, logs, status" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#78350f;align=left;verticalAlign=middle;spacing=8;fillColor=#fde68a;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="350" y="454" width="350" height="60" as="geometry"/></mxCell>
        <mxCell id="h_console" value="HumanConsole — human-in-the-loop threads / chat with agents" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#78350f;align=left;verticalAlign=middle;spacing=8;fillColor=#fde68a;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="350" y="526" width="350" height="60" as="geometry"/></mxCell>
        <mxCell id="h_gate" value="Tool-surface gating:  hub READ tools always available;  WRITE tools require focus_hub first." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;dashed=1;fontFamily=Helvetica;fontSize=11;fontColor=#92400e;align=left;verticalAlign=middle;spacing=8;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="350" y="598" width="350" height="56" as="geometry"/></mxCell>

        <mxCell id="h_mon" value="📊  Live Monitor&#10;&#10;reads HubRegistry.snapshot()&#10;SSE /api/projects/&lt;id&gt;/events&#10;+ state polling (1.8s / 30s)&#10;&#10;Shows:  agent status, phase&#10;timeline, plan completion %,&#10;tool calls, hub stats,&#10;artifacts, logs, mailboxes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#1e3a8a;align=left;verticalAlign=top;spacing=10;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="780" y="150" width="220" height="290" as="geometry"/></mxCell>

        <mxCell id="h_user" value="👤  User&#10;watches + intervenes / adjusts budget via HumanConsole" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#1e3a8a;align=center;verticalAlign=middle;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="780" y="500" width="220" height="80" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="he1" value="read via hub_pulse  /  write via hub_commit_gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;startArrow=open;strokeColor=#d97706;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#b45309;fontSize=10;" edge="1" parent="1" source="h_agents" target="h_pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he2" value="snapshot + SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563eb;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontColor=#2563eb;fontSize=10;" edge="1" parent="1" source="h_pool" target="h_mon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563eb;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="h_mon" target="h_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he4" value="chat / steer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;startArrow=open;strokeColor=#2563eb;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontColor=#2563eb;fontSize=10;" edge="1" parent="1" source="h_user" target="h_console"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

