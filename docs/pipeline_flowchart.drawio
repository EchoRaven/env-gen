          <mxGeometry x="80" y="120" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c_form" value="🖥  Live Monitor — New Project page  (/projects/new · React SPA)&#10;&#10;Form fields:&#10;•  name  +  generation prompt (description)  — required&#10;•  model  +  provider  (OpenAI / Anthropic / Google / Azure / OpenRouter / local)&#10;•  API key  (optional)&#10;•  max wall-clock (min)  +  max coordination ticks&#10;•  reference images / docs  (≤ 10 MB)&#10;•  delivery gates  (custom typed checks)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#1e3a8a;align=left;verticalAlign=top;spacing=10;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="270" y="110" width="560" height="200" as="geometry"/></mxCell>

        <mxCell id="c_post" value="POST /api/runs  →  live_monitor_server.py  (ThreadingHTTPServer)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#1e3a8a;align=center;verticalAlign=middle;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="270" y="340" width="560" height="44" as="geometry"/></mxCell>

        <mxCell id="c_srv" value="Server-side handling:&#10;•  create workspace  generated/&lt;id&gt;/&#10;•  register project via HubRegistry  (appears in UI list immediately)&#10;•  persist run → .runs.json  (crash recovery)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#312e81;align=left;verticalAlign=top;spacing=10;fillColor=#e0e7ff;strokeColor=#4f46e5;" vertex="1" parent="1">
          <mxGeometry x="270" y="416" width="560" height="100" as="geometry"/></mxCell>

        <mxCell id="c_spawn" value="Spawn orchestrator subprocess:&#10;python -m env_generator.llm_generator.main&#10;--name --model --provider --description --reference-images" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=12;fontColor=#312e81;align=left;verticalAlign=top;spacing=10;fillColor=#e0e7ff;strokeColor=#4f46e5;" vertex="1" parent="1">
          <mxGeometry x="270" y="548" width="560" height="80" as="geometry"/></mxCell>

        <mxCell id="c_orch" value="🎛  Orchestrator.run()&#10;•  initialize HubRegistry (6 hubs) + MessageBus&#10;•  spawn resident agent lanes: Orchestrator / Design / Database / Backend / Frontend / Verifier / Knowledge&#10;•  enter phase-based dispatch" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#312e81;align=left;verticalAlign=top;spacing=10;fillColor=#e0e7ff;strokeColor=#4f46e5;" vertex="1" parent="1">
          <mxGeometry x="270" y="660" width="560" height="100" as="geometry"/></mxCell>

        <mxCell id="c_step" value="Per-step pipeline, enforced in code for every agent step:&#10;hub_pulse  →  runtime_team_status  →  planning  →  retrieve_context&#10;→  action (≤ 15 tool rounds)  →  hub_commit_gate  →  knowledge_sync" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=1;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#4338ca;align=left;verticalAlign=top;spacing=10;fillColor=#eef2ff;strokeColor=#6366f1;" vertex="1" parent="1">
          <mxGeometry x="270" y="792" width="560" height="80" as="geometry"/></mxCell>

