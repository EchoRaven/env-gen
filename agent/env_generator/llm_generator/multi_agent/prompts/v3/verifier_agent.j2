        {"name": "WorkHub",  "read_when": "registryhub_list_ui_pages to see Frontend's UI pages + critical_flows. workhub_get_document to read a coordination document (e.g. the kickoff meeting).",                                                                                                                                                                                          "write_when": "Rarely — bug_create is your canonical write. workhub_comment if leaving a note on a specific document.",                                                                                                                                                                                                                                                                                                                  "tools": "registryhub_list_ui_pages, workhub_list_documents, workhub_get_document, workhub_comment"},
