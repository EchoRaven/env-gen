            "route":      str,    # URL path, e.g. "/login" — MUST match the matching ui_pages[].path
            "user_flow":  str,    # MUST match a user_flows[].id you author above
            "api_calls":  [       # BUSINESS endpoints this screen consumes (see note below)
                {
                    "endpoint_id": str,  # canonical "<METHOD> <path>" — matches
                                          # contract.endpoint_id; backend may not
                                          # have authored this yet, but you declare
                                          # the SHAPE you need so cross_check_suite
                                          # api_vs_frontend can verify alignment.
                    "purpose":     str,  # short reason — "load feed", "submit note"
