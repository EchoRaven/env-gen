<api_response_handling>
Backend returns `{[response_key]: [...], total: N}` for lists and `{item: {...}}` for single. The exact response_key is in `registryhub_list_endpoints` → schema.response_key.

```javascript
// CORRECT — the projector envelope is FIXED: data.items (list) / data.item (single)
const response = await fetch('/api/tasks');
const data = await response.json();
const tasks = data.items;        // a list endpoint always returns {items: [...], total: N}
tasks.map(task => ...)
// (a single-resource endpoint returns {item: {...}} → read data.item)

// WRONG — assumes a top-level array, or a custom key the projector never emits
const tasks = await fetch('/api/tasks').then(r => r.json());
tasks.map(...)              // ERROR! the body is {items: [...]}, not an array
const tasks2 = data.tasks;  // ERROR! the projector emits data.items, not data.tasks → blank page
```

Errors: FastAPI returns `{"detail": "..."}` with the HTTP status — read `data.detail` (the api.js `request()` helper throws `(await res.json()).detail`). The `{error: {message}}` shape is NEVER emitted; do not read `error.error?.message`.
</api_response_handling>


<api_service_template>
**CONSISTENCY RULE:** `api.js` is a 1:1 mirror of the **business** API contract. Emit **exactly one wrapper method per `registryhub_list_endpoints()` entry whose `metadata.kind` is unset/empty (a business endpoint)** — same method/path, extract the registered `schema.response_key`. **SKIP** any endpoint tagged `metadata.kind ∈ {auth, oauth, infra, spine}**: those are the orchestrator-registered fixed surface (the embedded OAuth2 AS, the `/auth/*` credential endpoints, the tenant/health control plane). They are FIXED-SPEC with heterogeneous shapes (a 302 redirect, a `{access_token}`, a JWKS doc) — do NOT response_key them. Use the small hand-written `login()/register()/listTenants()` helpers below (which call the registered `/auth/*` + `/api/v1/*` paths directly). Do NOT invent business endpoints, rename paths, or guess response keys; that breaks contract↔frontend consistency (the verifier's `api_smoke` flags it). The base URL is a runtime global (`window.APP_API_URL || ''`), NOT `import.meta.env`, so nginx proxying + HTTPS work without mixed-content.

```javascript
// src/services/api.js
const API_BASE = (typeof window !== 'undefined' && window.APP_API_URL) || '';  // same-origin; nginx proxies /api

// tenant: prefer the JWT tenant_id claim (siblings share localStorage), else stored, else 'default'
function _decodeTenant(tok) {
  try { return JSON.parse(atob(tok.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))).tenant_id; }
  catch { return null; }
}
export function getTenant() {
  const t = localStorage.getItem('access_token');
  return (t && _decodeTenant(t)) || localStorage.getItem('X_TENANT_ID') || 'default';
}
export function setTenant(id) { localStorage.setItem('X_TENANT_ID', id); }

async function request(path, options = {}) {
  const token = localStorage.getItem('access_token');
  const res = await fetch(`${API_BASE}${path}`, {
    ...options,
    headers: {
      'Content-Type': 'application/json',
      'X-Tenant-ID': getTenant(),
      ...(token && { Authorization: `Bearer ${token}` }),
      ...options.headers,
    },
    body: options.body ? JSON.stringify(options.body) : undefined,
  });
  if (res.status === 401) { /* optional: _tryRefresh() then retry once */ }
  if (!res.ok) throw new Error((await res.json().catch(() => ({}))).detail || 'Request failed');
  return res.json();
}

// --- one method per registered endpoint; use the registered response_key ---
export async function getTasks() { return (await request('/api/tasks')).items || []; }   // response_key='items'
export async function getTask(id) { return (await request(`/api/tasks/${id}`)).item; }     // response_key='item'

// --- auth + tenants: the env IS its own OAuth2 AS (embedded). These paths are
//     orchestrator-registered (kind='auth'/'infra') — hand-written helpers, NOT
//     response_key-mirrored. /auth/login + /auth/register return {access_token}. ---
export async function login(email, password) {
  const d = await request('/auth/login', { method: 'POST', body: { email, password, tenant_id: getTenant() } });
  localStorage.setItem('access_token', d.access_token);
  return d;
}
export async function register(email, name, password) {
  const d = await request('/auth/register', { method: 'POST', body: { email, name, password, tenant_id: getTenant() } });
  if (d.access_token) localStorage.setItem('access_token', d.access_token);
  return d;
}
export async function listTenants() { return (await request('/api/v1/tenants')).items || []; }
export async function createTenant(id, name) { return request('/api/v1/tenants', { method: 'POST', body: { id, name } }); }
```
</api_service_template>


