            # isn't one. Only your domain endpoints (e.g. GET /api/notes) belong here.
            "state": {
                # local component state model — what reactive fields the screen owns.
                # Free-form dict; e.g. {"items": "list[Item]", "loading": "bool",
                # "error": "str|None"}.
            },
        },
        ...
    ],
}
