**This block lives INSIDE `main.py`** (not a separate file). It wires the runtime-owned AS and defines the identity layer. The env IS the Authorization Server: `users` carries a `password_hash`, we MINT RS256 tokens (`sub`=str(user.id)), and verify them against the manager's PUBLIC key. There is NO separate `auth.py` and NO HS256 secret.

```python
# ── main.py: embedded OAuth2 AS wiring + identity ────────────────────────────
import os, hashlib
from pathlib import Path
from typing import Optional, Annotated
from fastapi import Header, Request, Query
from fastapi.security import OAuth2PasswordRequestForm
from pydantic import BaseModel
import jwt as _pyjwt
from jwt_manager import ALGORITHM as _RS_ALG, JWTManager   # RUNTIME-OWNED
from oauth_store import OAuthStore                          # RUNTIME-OWNED
from oauth_routes import build_router as _build_oauth_router  # RUNTIME-OWNED

# (1) construct the AS once + mount its router (/.well-known/*, /oauth/*)
_JWT_DATA_DIR = os.getenv("JWT_DATA_DIR", "/var/lib/app-auth")
Path(_JWT_DATA_DIR).mkdir(parents=True, exist_ok=True)
_jwt_manager = JWTManager(data_dir=_JWT_DATA_DIR)
_oauth_store = OAuthStore()
_JWT_PUBLIC_PEM = _jwt_manager.public_pem
app.include_router(_build_oauth_router(_oauth_store, _jwt_manager))

APP_AUDIENCE  = os.getenv("OAUTH_DEFAULT_AUDIENCE", "app-api")
APP_SCOPE     = os.getenv("OAUTH_DEFAULT_SCOPE", "app.read app.write app.admin")
ACCESS_TTL    = int(os.getenv("OAUTH_ACCESS_TOKEN_TTL", "3600"))
PASSWORD_SALT = os.getenv("APP_PASSWORD_SALT", "app_sandbox_salt_2024")  # MUST match oauth_store

def _hash_password(pw: str) -> str:
    return hashlib.sha256((pw + PASSWORD_SALT).encode()).hexdigest()

def _issuer(request: Request) -> str:
    return (os.getenv("OAUTH_ISSUER") or str(request.base_url)).rstrip("/")

def _mint(user: User, request: Request) -> str:
    # sub = str(users.id); get_current_user resolves int(sub) back to the row.
    return _jwt_manager.sign_access_token(
        subject=str(user.id), issuer=_issuer(request), audience=APP_AUDIENCE,
        scope=APP_SCOPE, ttl_seconds=ACCESS_TTL,
        extra_claims={"email": user.email, "name": user.name,
                      "tenant_id": user.tenant_id, "client_id": "app-ui"})

# (2) first-party register/login (scoped by (email, tenant_id))
class _Register(BaseModel):
    email: str; password: str; name: Optional[str] = None; tenant_id: Optional[str] = "default"
class _Login(BaseModel):
    email: str; password: str; tenant_id: Optional[str] = "default"

@app.post("/auth/register", status_code=201)
def auth_register(body: _Register, request: Request, db: Session = Depends(get_db)):
    email = (body.email or "").strip().lower(); tid = (body.tenant_id or "default").strip() or "default"
    if not email or not body.password:
        raise HTTPException(status_code=400, detail="missing email or password")
    if not db.get(Tenant, tid):
        db.add(Tenant(id=tid)); db.commit()
    if db.query(User).filter(User.email == email, User.tenant_id == tid).first():
        raise HTTPException(status_code=400, detail="user already exists in this tenant")
    u = User(email=email, name=(body.name or email.split("@")[0].title()),
             password_hash=_hash_password(body.password), tenant_id=tid)
    db.add(u); db.commit(); db.refresh(u)
    return {"user": {"id": u.id, "email": u.email, "name": u.name, "tenant_id": u.tenant_id},
            "access_token": _mint(u, request), "token_type": "Bearer", "expires_in": ACCESS_TTL}

@app.post("/auth/login")
def auth_login(body: _Login, request: Request, db: Session = Depends(get_db)):
    tid = (body.tenant_id or "default").strip() or "default"
    u = db.query(User).filter(User.email == (body.email or "").strip().lower(), User.tenant_id == tid).first()
    if not u or u.password_hash != _hash_password(body.password):
        raise HTTPException(status_code=401, detail="invalid credentials")
    return {"access_token": _mint(u, request), "token_type": "Bearer", "expires_in": ACCESS_TTL}

# (3) get_current_user: verify the RS256 bearer against our PUBLIC key, resolve int(sub).
def get_current_user(authorization: Annotated[Optional[str], Header()] = None,
                     token: Optional[str] = Query(default=None),
                     db: Session = Depends(get_db)) -> dict:
    raw = None
    if authorization:
        raw = authorization[7:] if authorization.startswith("Bearer ") else authorization
    raw = raw or token
    if not raw:
        raise HTTPException(status_code=401, detail="missing bearer token")
    try:
        # verify_aud=False on purpose — aud is enforced at the MCP/resource layer.
        claims = _pyjwt.decode(raw, _JWT_PUBLIC_PEM, algorithms=[_RS_ALG], options={"verify_aud": False})
    except _pyjwt.PyJWTError:
        raise HTTPException(status_code=401, detail="invalid or expired token")
    try:
        uid = int(claims.get("sub"))
    except (TypeError, ValueError):
        raise HTTPException(status_code=401, detail="invalid token subject")
    u = db.get(User, uid)
    if not u:
        raise HTTPException(status_code=401, detail="unknown user")
    return {"id": u.id, "email": u.email, "name": u.name, "tenant_id": u.tenant_id}
```

**SQL safety:** use the SQLAlchemy ORM / parameterized queries — never f-string user input into SQL.
**Salt invariant:** `APP_PASSWORD_SALT` MUST equal `oauth_store.PASSWORD_SALT` (`app_sandbox_salt_2024`) — otherwise the AS-hosted `/oauth/authorize` login and your `/auth/login` disagree on the same user's password.
</auth_wiring>


