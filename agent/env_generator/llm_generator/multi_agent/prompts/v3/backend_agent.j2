# models.py — SQLAlchemy ORM. The DDL is also emitted to init/01_init.sql by the
# runtime; keep the two consistent (same table/column names, same FKs).
from sqlalchemy import Column, Integer, String, Text, ForeignKey, DateTime, UniqueConstraint
from sqlalchemy.orm import declarative_base, relationship
from datetime import datetime

Base = declarative_base()

class Tenant(Base):                               # spine-owned (DDL in init/01_init.sql)
    __tablename__ = "tenants"
    id = Column(String, primary_key=True)        # TEXT id, e.g. 'default'
    name = Column(String, nullable=False, default="")
    status = Column(String, nullable=False, default="active")
    created_at = Column(DateTime, default=datetime.utcnow)

class User(Base):                                 # spine-owned identity (the env IS the AS)
    __tablename__ = "users"
    id = Column(Integer, primary_key=True)        # local SERIAL — JWT sub == str(id); business FKs point HERE
    email = Column(String, nullable=False)
    name = Column(String, nullable=False)
    password_hash = Column(String, nullable=False)  # sha256(password + 'app_sandbox_salt_2024')
    tenant_id = Column(String, ForeignKey("tenants.id", ondelete="CASCADE"), nullable=False, default="default")
    created_at = Column(DateTime, default=datetime.utcnow)
    __table_args__ = (UniqueConstraint("email", "tenant_id"),)

class Post(Base):                                 # business table — NO tenant_id column!
    __tablename__ = "posts"
    id = Column(Integer, primary_key=True)
    user_id = Column(Integer, ForeignKey("users.id", ondelete="CASCADE"), nullable=False)
    body = Column(Text); created_at = Column(DateTime, default=datetime.utcnow)
