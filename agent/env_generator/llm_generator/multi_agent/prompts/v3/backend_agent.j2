# main.py
import os

# MANDATORY (before app/routers): sandbox hosts block new pthread creation, so
# FastAPI's default threadpool dispatch crashes. Force sync routes to run inline.
import starlette.concurrency, fastapi.routing, fastapi.dependencies.utils
async def _run_without_threadpool(func, *args, **kwargs):
    return func(*args, **kwargs)
starlette.concurrency.run_in_threadpool = _run_without_threadpool
fastapi.routing.run_in_threadpool = _run_without_threadpool
fastapi.dependencies.utils.run_in_threadpool = _run_without_threadpool

from fastapi import FastAPI, Depends, HTTPException, Header
from fastapi.middleware.cors import CORSMiddleware
from sqlalchemy.orm import Session
import uvicorn

from database import get_db, SessionLocal
from models import Tenant, User  # + business models

app = FastAPI(title="<Env> API", version="1.0.0")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_credentials=True,
                   allow_methods=["*"], allow_headers=["*"])

# ── embedded OAuth2 AS wiring + identity (see <auth_wiring>) ──────────────────
# jwt_manager.py / oauth_store.py / oauth_routes.py are RUNTIME-OWNED (already in
# app/backend/). Paste the <auth_wiring> block HERE: it constructs _jwt_manager +
# _oauth_store, mounts the AS router, and defines _hash_password / _mint_user_jwt /
# /auth/register + /auth/login + get_current_user. get_current_user is the auth
# Depends used by every business endpoint below.

@app.get("/")
def root():
    return {"message": "<Env> API", "version": "1.0.0"}

@app.get("/health")
def health():
    return {"status": "healthy"}

# --- tenant control surface (UNAUTHENTICATED — the test harness drives these) ---
@app.post("/api/v1/admin/init-tenant")
def init_tenant(x_tenant_id: str = Header("default", alias="X-Tenant-Id"), db: Session = Depends(get_db)):
    if not db.get(Tenant, x_tenant_id):
        db.add(Tenant(id=x_tenant_id)); db.commit()
    return {"tenant_id": x_tenant_id, "created": {}, "skipped": []}

@app.post("/api/v1/reset")
def reset(x_tenant_id: str | None = Header(None, alias="X-Tenant-Id"), db: Session = Depends(get_db)):
    # X-Tenant-Id => delete only that tenant's BUSINESS rows (child-first FK order),
    # PRESERVE the users + tenants rows. No header => factory reset (dev only).
    # ... delete business rows scoped to the tenant's users ...
    return {"ok": True, "tenant_id": x_tenant_id}

@app.get("/api/v1/tenants")
def list_tenants(db: Session = Depends(get_db)):
    return {"items": [{"id": t.id} for t in db.query(Tenant).all()]}

@app.post("/api/v1/tenants")
def create_tenant(body: dict, db: Session = Depends(get_db)):
    tid = body.get("id") or body.get("tenant_id")
    if not db.get(Tenant, tid):
        db.add(Tenant(id=tid)); db.commit()
    return {"id": tid}

@app.delete("/api/v1/tenants/{tenant_id}")
def delete_tenant(tenant_id: str, db: Session = Depends(get_db)):
    if tenant_id == "default":
        raise HTTPException(status_code=400, detail="cannot delete default tenant")
    t = db.get(Tenant, tenant_id)
    if not t:
        raise HTTPException(status_code=404, detail="tenant not found")
    db.delete(t); db.commit()  # ON DELETE CASCADE wipes users + business rows
    return {"ok": True}

# --- business endpoints: sync def, Depends(get_db)+Depends(get_current_user),
#     ALWAYS filter by user["id"] (the tenant boundary — see <tenancy>) ---
@app.get("/api/posts")
def list_posts(db: Session = Depends(get_db), user: dict = Depends(get_current_user)):
    rows = db.query(Post).filter(Post.user_id == user["id"]).all()
    return {"items": [PostResponse.model_validate(r).model_dump() for r in rows], "total": len(rows)}

if __name__ == "__main__":
    # loop=asyncio + http=h11 are MANDATORY: uvloop/httptools spawn native threads
    # and fail in the sandbox. Pass the app object directly (no reload).
    uvicorn.run(app, host="0.0.0.0",
                port=int(os.getenv("API_PORT", os.getenv("PORT", "8080"))),
                loop="asyncio", http="h11")
